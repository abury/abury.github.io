---
import { site, nav } from '../data/site';
---

<header class="site-header">
  <div class="wordmark">{site.name}</div>
  <nav class="site-nav" aria-label="Sections">
    {nav.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
  <a href="#contact" class="btn btn-dark btn-sm">Get in touch</a>
</header>

<style>
  .site-header {
    max-width: var(--max);
    margin: 0 auto;
    padding: 20px var(--gutter);
    container-type: inline-size;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
  }

  .wordmark {
    font-family: var(--ff-display);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: -0.02em;
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 4px;
    font-size: 15px;
    font-weight: 500;
  }

  .site-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    text-decoration: none;
  }

  @container (max-width: 600px) {
    .site-nav {
      display: none;
    }
  }
</style>
